# NexusSync ERP Environment Variables
GEMINI_API_KEY=
PORT=3000
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
NODE_ENV=development
# Costing & Inventory Engine Strict Validation Flag (false: fallback to product cost_price with warning; true: reject transaction with ERR_COSTING_LAYER_DEPLETED)
FEATURE_STRICT_COSTING_VALIDATION=false

# Costing Engine Shadow Run Flag (false: disabled; true: parallel non-blocking evaluation of new engine without DB writes)
FEATURE_SHADOW_RUN_ENABLED=false

# Phase 5 Rollout Scope (FIFO new engine): "NONE" (disabled), "ALL" (100% rollout), or list of SKUs/warehouses (e.g. "WH:1" or "SKU:PRD-001,SKU:SKU-RAW-101")
FEATURE_NEW_COSTING_ROLLOUT_SCOPE=NONE

